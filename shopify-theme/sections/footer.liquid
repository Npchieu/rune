<footer class="site-footer" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <!-- Marquee top border -->
  <div class="site-footer__marquee">
    <div class="marquee-track">
      <div class="marquee-inner" style="animation-duration: 20s;">
        {%- for i in (1..8) -%}
          <span>AS ALWAYS, WITH LOVE ®</span>
          <span class="marquee-sep">✦</span>
        {%- endfor -%}
      </div>
      <div class="marquee-inner" aria-hidden="true" style="animation-duration: 20s;">
        {%- for i in (1..8) -%}
          <span>AS ALWAYS, WITH LOVE ®</span>
          <span class="marquee-sep">✦</span>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="site-footer__body">
    <!-- Brand column -->
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo">SCUFFERS</a>
      <p class="site-footer__tagline">Everyday Urban Aesthetics</p>
      <div class="site-footer__socials">
        {%- if section.settings.instagram != blank -%}
          <a href="https://instagram.com/{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if section.settings.tiktok != blank -%}
          <a href="https://tiktok.com/@{{ section.settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- Nav columns -->
    <div class="site-footer__nav">
      <div class="site-footer__nav-col">
        <h3 class="site-footer__nav-title">SHOP</h3>
        <ul>
          <li><a href="/collections/all">All Products</a></li>
          <li><a href="/collections/hoodies">Hoodies</a></li>
          <li><a href="/collections/t-shirts">T-Shirts</a></li>
          <li><a href="/collections/caps">Caps</a></li>
          <li><a href="/collections/accessories">Accessories</a></li>
        </ul>
      </div>
      <div class="site-footer__nav-col">
        <h3 class="site-footer__nav-title">INFO</h3>
        <ul>
          <li><a href="/pages/about">About Us</a></li>
          <li><a href="/pages/sizing">Sizing Guide</a></li>
          <li><a href="/pages/shipping">Shipping</a></li>
          <li><a href="/pages/returns">Returns</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </div>
      <div class="site-footer__nav-col">
        <h3 class="site-footer__nav-title">NEWSLETTER</h3>
        <p class="site-footer__newsletter-desc">Be first to know. No spam, ever.</p>
        {%- form 'customer', id: 'footer-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="site-footer__newsletter-form">
            <input
              type="email"
              name="contact[email]"
              placeholder="YOUR EMAIL"
              required
              autocomplete="email"
              class="newsletter-input"
            >
            <button type="submit" class="newsletter-btn" aria-label="Subscribe">→</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="site-footer__bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    <div class="site-footer__legal">
      <a href="/policies/privacy-policy">Privacy</a>
      <a href="/policies/terms-of-service">Terms</a>
      <a href="/policies/refund-policy">Refunds</a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "instagram",
      "label": "Instagram handle"
    },
    {
      "type": "text",
      "id": "tiktok",
      "label": "TikTok handle"
    }
  ]
}
{% endschema %}
