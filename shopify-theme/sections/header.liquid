<header class="site-header" id="site-header" data-color-initial="{{ section.settings.initial_color }}">

  <!-- Top bar: Man / Woman / Footwear | LOGO | country search account cart -->
  <div class="site-header__top">

    <!-- Left: primary nav -->
    <nav class="site-header__primary-nav" aria-label="Primary navigation">
      <a href="/collections/man" class="primary-nav__link">Man</a>
      <a href="/collections/woman" class="primary-nav__link">Woman</a>
      <a href="/collections/footwear" class="primary-nav__link">Footwear</a>
    </nav>

    <!-- Center: logo (color changes on scroll) -->
    <a href="/" class="site-header__logo" id="site-logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 320 }}"
          alt="{{ shop.name }}"
          class="site-header__logo-img"
          width="160"
          height="44"
          loading="eager"
        >
      {%- else -%}
        <span class="site-header__logo-text">
          scuffers
          <svg class="logo-wing" width="28" height="20" viewBox="0 0 28 20" fill="none" aria-hidden="true">
            <path d="M2 18 C6 10, 14 4, 26 2 M26 2 L20 6 M26 2 L22 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      {%- endif -%}
    </a>

    <!-- Right: icons -->
    <div class="site-header__icons">
      <a href="/pages/country" class="header-icon-btn" aria-label="Select country">
        <span class="header-icon-label">{{ section.settings.country_label | default: 'country' }}</span>
      </a>
      <a href="/search" class="header-icon-btn" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </a>
      <a href="/account" class="header-icon-btn" aria-label="Account">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
      </a>
      <button class="header-icon-btn" id="cart-toggle" aria-label="Open cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="cart-count" id="cart-count" style="display:none">0</span>
      </button>
      <!-- Mobile hamburger -->
      <button class="site-header__hamburger" id="mobile-menu-toggle" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Sub-nav: category strip (visible when scrolled or on collection pages) -->
  <nav class="site-header__subnav" id="site-subnav" aria-label="Category navigation">
    <a href="/collections/new-in" class="subnav__link">New in</a>
    <a href="/collections/hoodies" class="subnav__link">Hoodies</a>
    <a href="/collections/knitwear" class="subnav__link">Knitwear</a>
    <a href="/collections/long-sleeves" class="subnav__link">Long sleeves</a>
    <a href="/collections/pants-sweatpants" class="subnav__link">Pants &amp; sweatpants</a>
    <a href="/collections/outerwear" class="subnav__link">Outerwear</a>
    <a href="/collections/t-shirts" class="subnav__link">T-shirts</a>
    <a href="/collections/tank-tops" class="subnav__link">Tank tops</a>
    <a href="/collections/shirts" class="subnav__link">Shirts</a>
    <a href="/collections/polos" class="subnav__link">Polos</a>
    <a href="/collections/shorts" class="subnav__link">Shorts</a>
    <a href="/collections/accessories" class="subnav__link">Accessories</a>
    <a href="/collections/footwear" class="subnav__link">Footwear</a>
    <a href="/collections/just-woman" class="subnav__link">Just woman</a>
  </nav>

</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "country_label",
      "label": "Country label",
      "default": "country"
    },
    {
      "type": "select",
      "id": "initial_color",
      "label": "Initial logo color",
      "options": [
        {"value": "light", "label": "Light (white)"},
        {"value": "dark", "label": "Dark (black)"}
      ],
      "default": "dark"
    }
  ]
}
{% endschema %}
