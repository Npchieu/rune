<section
  class="collection-banners"
  data-header-color="{{ section.settings.header_color }}"
  style="background-color: {{ section.settings.bg_color }};"
>
  {%- if section.settings.section_label != blank -%}
    <div class="collection-banners__label">
      <span style="color: {{ section.settings.label_color }}">{{ section.settings.section_label }}</span>
    </div>
  {%- endif -%}

  <div class="collection-banners__grid collection-banners__grid--{{ section.blocks.size }}">
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.link }}"
        class="collection-banner"
        data-index="{{ forloop.index }}"
        {{ block.shopify_attributes }}
      >
        <div class="collection-banner__media">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 1000 }}"
              alt="{{ block.settings.label | escape }}"
              class="collection-banner__img"
              loading="lazy"
              width="500"
              height="700"
            >
          {%- else -%}
            <div class="collection-banner__placeholder" style="background: {{ block.settings.fallback_color }};"></div>
          {%- endif -%}
          <div class="collection-banner__overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
        </div>

        <div class="collection-banner__content" style="color: {{ block.settings.text_color }};">
          {%- if block.settings.eyebrow != blank -%}
            <span class="collection-banner__eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          <h3 class="collection-banner__label">{{ block.settings.label }}</h3>
          <span class="collection-banner__cta">
            {{ block.settings.cta | default: 'SHOP NOW' }}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="collection-banner__arrow">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection Banners",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#0a0a0a"
    },
    {
      "type": "select",
      "id": "header_color",
      "label": "Header/logo color when in this section",
      "options": [
        {"value": "light", "label": "Light (white)"},
        {"value": "dark", "label": "Dark (black)"}
      ],
      "default": "light"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label",
      "default": "COLLECTIONS"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Section label color",
      "default": "#666666"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "fallback_color",
          "label": "Fallback background color",
          "default": "#1a1a1a"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "default": 30
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "default": "NEW"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Collection name",
          "default": "HOODIES"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "CTA text",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Banners",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "label": "HOODIES",
            "eyebrow": "DROP 01",
            "cta": "SHOP NOW"
          }
        },
        {
          "type": "banner",
          "settings": {
            "label": "T-SHIRTS",
            "eyebrow": "DROP 02",
            "cta": "SHOP NOW"
          }
        },
        {
          "type": "banner",
          "settings": {
            "label": "CAPS",
            "eyebrow": "DROP 03",
            "cta": "SHOP NOW"
          }
        }
      ]
    }
  ]
}
{% endschema %}
