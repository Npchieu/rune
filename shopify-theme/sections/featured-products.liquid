<section
  class="featured-products"
  data-header-color="{{ section.settings.header_color }}"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="featured-products__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="featured-products__heading" style="color: {{ section.settings.text_color }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    {%- if section.settings.collection != blank -%}
      <a href="{{ section.settings.collection.url }}" class="featured-products__view-all" style="color: {{ section.settings.text_color }}">
        VIEW ALL
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </a>
    {%- endif -%}
  </div>

  <div class="products-grid products-grid--{{ section.settings.columns }}">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank -%}
      {%- for product in collection.products limit: section.settings.product_limit -%}
        {%- render 'product-card', product: product, text_color: section.settings.text_color -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.product_limit) -%}
        <div class="product-card product-card--placeholder">
          <div class="product-card__media product-card__media--placeholder">
            {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          <div class="product-card__info">
            <span class="product-card__title" style="color: {{ section.settings.text_color }}">PRODUCT NAME</span>
            <span class="product-card__price" style="color: {{ section.settings.text_color }}">€ 89.00</span>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        {"value": "2", "label": "2"},
        {"value": "3", "label": "3"},
        {"value": "4", "label": "4"}
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "LATEST DROP"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "header_color",
      "label": "Header/logo color when in this section",
      "options": [
        {"value": "light", "label": "Light (white)"},
        {"value": "dark", "label": "Dark (black)"}
      ],
      "default": "light"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
