<section class="featured-products" data-header-color="dark" style="background:#fff;">
  {%- if section.settings.heading != blank -%}
    <div class="featured-products__header">
      <h2 class="featured-products__heading">{{ section.settings.heading }}</h2>
      {%- assign src_collection = collections[section.settings.collection] -%}
      {%- if src_collection != blank -%}
        <a href="{{ src_collection.url }}" class="featured-products__view-all">
          View all
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.2"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="products-grid products-grid--{{ section.settings.columns }}">
    {%- assign col = collections[section.settings.collection] -%}
    {%- if col != blank -%}
      {%- for product in col.products limit: section.settings.product_limit -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.product_limit) -%}
        <div class="product-card product-card--placeholder">
          <div class="product-card__media">
            {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          <div class="product-card__info">
            <div class="product-card__title-row">
              <span class="product-card__title">Product Name</span>
              <span class="product-card__price">3.761.000 ₫</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {"type": "collection", "id": "collection", "label": "Collection"},
    {"type": "range", "id": "product_limit", "label": "Products to show", "min": 2, "max": 20, "step": 1, "default": 10},
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        {"value": "2", "label": "2"},
        {"value": "3", "label": "3"},
        {"value": "4", "label": "4"},
        {"value": "5", "label": "5"}
      ],
      "default": "5"
    },
    {"type": "text", "id": "heading", "label": "Section heading", "default": "New in"}
  ],
  "presets": [{"name": "Featured Products"}]
}
{% endschema %}
