<div class="product-card" data-product-id="{{ product.id }}">

  <!-- Media -->
  <a href="{{ product.url }}" class="product-card__media-link" aria-label="{{ product.title | escape }}">
    <div class="product-card__media">

      {%- if product.featured_media -%}
        <img
          src="{{ product.featured_media | image_url: width: 700 }}"
          alt="{{ product.featured_media.alt | escape }}"
          class="product-card__img product-card__img--primary"
          loading="lazy"
          width="350"
          height="467"
        >
        {%- if product.media[1] -%}
          <img
            src="{{ product.media[1] | image_url: width: 700 }}"
            alt="{{ product.media[1].alt | escape }}"
            class="product-card__img product-card__img--hover"
            loading="lazy"
            width="350"
            height="467"
          >
        {%- endif -%}
      {%- else -%}
        <div class="product-card__img-placeholder">{{ product.title | slice: 0 }}</div>
      {%- endif -%}

      <!-- NEW IN badge -->
      {%- assign new_threshold = 'now' | date: '%s' | minus: 1209600 -%}
      {%- assign created_ts = product.created_at | date: '%s' | plus: 0 -%}
      {%- if created_ts > new_threshold -%}
        <span class="product-card__badge product-card__badge--new">NEW IN</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="product-card__badge product-card__badge--sale">SALE</span>
      {%- endif -%}

      <!-- Quick add (+) button -->
      <div class="product-card__quick-add">
        {%- if product.variants.size == 1 and product.first_available_variant.available -%}
          <button
            class="product-card__quick-btn"
            aria-label="Quick add {{ product.title | escape }}"
            data-variant-id="{{ product.first_available_variant.id }}"
            data-product-title="{{ product.title | escape }}"
          >+</button>
        {%- else -%}
          <a href="{{ product.url }}" class="product-card__quick-btn" aria-label="Select options for {{ product.title | escape }}">+</a>
        {%- endif -%}
      </div>

    </div>
  </a>

  <!-- Info -->
  <div class="product-card__info">
    <div class="product-card__title-row">
      <a href="{{ product.url }}" class="product-card__title">{{ product.title }}</a>
      <div class="product-card__pricing">
        {%- if product.compare_at_price > product.price -%}
          <span class="product-card__price product-card__price--sale">{{ product.price | money }}</span>
          <span class="product-card__price product-card__price--compare">{{ product.compare_at_price | money }}</span>
        {%- else -%}
          <span class="product-card__price">{{ product.price | money }}</span>
        {%- endif -%}
      </div>
    </div>

    <!-- Color swatches from Color option -->
    {%- assign color_option = product.options_with_values | where: 'name', 'Color' | first -%}
    {%- assign color_option = color_option | default: product.options_with_values | where: 'name', 'Colour' | first -%}
    {%- if color_option -%}
      <div class="product-card__swatches">
        {%- for value in color_option.values -%}
          {%- assign swatch_color = value | downcase | replace: ' ', '' -%}
          <span
            class="swatch"
            title="{{ value }}"
            style="background-color: {{ swatch_color }};"
            data-value="{{ value }}"
          ></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

</div>
