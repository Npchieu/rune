{% comment %} Collection page template {% endcomment %}

<div class="collection-page" style="background: #0a0a0a; min-height: 100vh;">

  <!-- Collection Header -->
  <div class="collection-page__header">
    <div class="collection-page__header-inner">
      {%- if collection.image -%}
        <img
          src="{{ collection.image | image_url: width: 2000 }}"
          alt="{{ collection.title | escape }}"
          class="collection-page__hero-img"
          loading="eager"
        >
        <div class="collection-page__hero-overlay"></div>
      {%- endif -%}
      <div class="collection-page__hero-content">
        <h1 class="collection-page__title">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <div class="collection-page__desc">{{ collection.description }}</div>
        {%- endif -%}
        <span class="collection-page__count">{{ collection.products_count }} products</span>
      </div>
    </div>
  </div>

  <!-- Filters + Sort bar -->
  <div class="collection-page__toolbar">
    <div class="collection-page__toolbar-inner">
      <button class="collection-toolbar__filter-btn" id="filter-toggle" aria-expanded="false">
        FILTER
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M2 4h12M4 8h8M6 12h4" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>

      <span class="collection-toolbar__count">{{ collection.products_count }} ITEMS</span>

      <div class="collection-toolbar__sort">
        <label for="sort-select" class="visually-hidden">Sort by</label>
        <select id="sort-select" name="sort_by" class="sort-select">
          <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>FEATURED</option>
          <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>BEST SELLING</option>
          <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>PRICE: LOW–HIGH</option>
          <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>PRICE: HIGH–LOW</option>
          <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>NEWEST</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Products Grid -->
  <div class="collection-page__body">
    {%- if collection.products.size > 0 -%}
      <div class="products-grid products-grid--3" id="products-grid">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product, text_color: '#ffffff' -%}
        {%- endfor -%}
      </div>

      <!-- Pagination -->
      {%- if paginate.pages > 1 -%}
        <div class="pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="pagination__btn">← PREV</a>
          {%- endif -%}
          <span class="pagination__info">{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="pagination__btn">NEXT →</a>
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- else -%}
      <div class="collection-page__empty">
        <p>No products found.</p>
        <a href="/collections/all" class="btn btn--light">VIEW ALL</a>
      </div>
    {%- endif -%}
  </div>
</div>
